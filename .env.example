# Любой сервис с OpenAI-compatible Chat Completions API.
# Скопируйте в .env, впишите свои значения и загрузите:  set -a; source .env; set +a
# Файл .env в git не попадает (см. .gitignore). Не публикуйте ключи!

OPENAI_BASE_URL=https://example.com/v1/
OPENAI_API_KEY=your-key-here
OPENAI_MODEL=your-model-name

# Запасной вариант - локальная Ollama:
# OPENAI_BASE_URL=http://localhost:11434/v1/
# OPENAI_API_KEY=ollama
# OPENAI_MODEL=qwen3:4b
